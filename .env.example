# Copy to .env — never commit the real file.

# Private key of the wallet that pays for GovTrade API calls (Base mainnet,
# funded with USDC). This is the SAME kind of key you used in
# agent-payment-test/ earlier tonight. Needs 0x prefix, 66 chars total.
EVM_PRIVATE_KEY=0xYourWalletPrivateKeyHere

# Optional — defaults to the live deployment.
GOVTRADE_API_URL=https://govtrade-x402.onrender.com

